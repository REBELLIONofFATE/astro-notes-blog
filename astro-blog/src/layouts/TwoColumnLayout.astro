---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import type { CategoryNode } from '../utils/categories';

interface Props {
  title: string;
  description?: string;
  tree: CategoryNode[];
  currentCategoryPath?: string;
  totalNotes?: number;
}

const { title, description, tree, currentCategoryPath = '', totalNotes = 0 } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="two-col-layout">
    <Sidebar tree={tree} currentPath={currentCategoryPath} totalNotes={totalNotes} />
    <div class="main-col">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .two-col-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .main-col {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .two-col-layout {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
