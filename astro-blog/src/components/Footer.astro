---
// Footer.astro - 页脚组件，参考 Semantic UI 底部风格
---

<footer class="footer">
  <!-- 主体内容 -->
  <div class="footer-body">
    <div class="container footer-inner">
      <!-- 品牌区域 -->
      <div class="footer-brand">
        <div class="brand-logo">
          <span class="logo-text">Rebellion</span>
        </div>
        <p class="brand-desc">专注于前端开发与技术探索的个人博客。<br/>分享编程心得、项目实践和学习笔记。</p>
        <div class="social-links">
          <a href="#" class="social-icon" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="#" class="social-icon" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="social-icon" aria-label="掘金" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 19.5h20L12 2zm0 4l6.9 11.5H5.1L12 6z"/></svg>
          </a>
          <a href="#" class="social-icon" aria-label="知乎" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M5.721 0C2.251 0 0 2.25 0 5.719V18.28C0 21.751 2.252 24 5.721 24h12.56C21.751 24 24 21.75 24 18.281V5.72C24 2.249 21.75 0 18.281 0zm1.964 4.078h6.789c.078 0 .146.055.146.136v1.846c0 .08-.068.146-.146.146H9.441c-.078 0-.144-.065-.144-.146V4.214c0-.081.066-.136.144-.136zm-2.57 3.555h5.092c.078 0 .144.065.144.146v1.254c0 .08-.066.146-.144.146H5.115c-.078 0-.142-.065-.142-.146V7.779c0-.08.064-.146.142-.146zm2.348 3.625h4.926c.078 0 .146.065.146.146v1.254c0 .08-.068.146-.146.146H7.463c-.078 0-.142-.065-.142-.146v-1.254c0-.08.064-.146.142-.146z"/></svg>
          </a>
        </div>
      </div>

      <!-- 导航区域 -->
      <div class="footer-nav">
        <div class="nav-group">
          <h4 class="nav-title">站点</h4>
          <div class="nav-list">
            <a href="/about">关于</a>
            <a href="/links">友情链接</a>
            <a href="/guestbook">留言板</a>
            <a href="#" target="_blank" rel="noopener noreferrer">博客源码</a>
          </div>
        </div>
        <div class="nav-group">
          <h4 class="nav-title">联系</h4>
          <div class="nav-list">
            <a href="mailto:your@email.com">发邮件 &nearr;</a>
          </div>
        </div>
        <div class="nav-group">
          <h4 class="nav-title">工具</h4>
          <div class="nav-list">
            <a href="/rss.xml">RSS 订阅</a>
            <a href="/sitemap-index.xml">站点地图</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 底栏 -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p>&copy; {new Date().getFullYear()} Rebellion &middot; Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></p>
      <p class="icp"><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">陕ICP备2025082251号</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
  }

  /* ── 主体内容 ── */
  .footer-body {
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 0 2rem;
    transition: border-color 0.3s ease;
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 4rem;
  }

  /* ── 品牌区域 ── */
  .footer-brand {
    flex: 0 1 auto;
    min-width: 220px;
    max-width: 320px;
  }

  .brand-logo {
    margin-bottom: 0.75rem;
  }

  .brand-logo .logo-text {
    font-family: "Caveat", cursive;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.01em;
    transition: color 0.3s ease;
  }

  .brand-desc {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
  }

  /* ── 社交图标 ── */
  .social-links {
    display: flex;
    gap: 0.5rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .social-icon:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    opacity: 1;
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .social-icon:hover :global(svg) {
    color: #fff;
  }

  .social-icon svg {
    transition: color 0.25s ease;
  }

  /* ── 导航区域 ── */
  .footer-nav {
    display: flex;
    gap: 3rem;
    padding-top: 0.25rem;
    flex: 0 0 auto;
  }

  .nav-group {
    min-width: 100px;
  }

  .nav-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    opacity: 0.85;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nav-list a {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease, padding-left 0.2s ease;
    display: inline-block;
    padding-left: 0;
  }

  .nav-list a:hover {
    color: var(--color-accent);
    opacity: 1;
    text-decoration: none;
    padding-left: 4px;
  }

  /* ── 底栏 ── */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1rem 2rem;
    transition: border-color 0.3s ease;
  }

  .bottom-inner {
    text-align: center;
  }

  .bottom-inner p {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    margin: 0;
    opacity: 0.7;
  }

  .bottom-inner a {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .bottom-inner a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    opacity: 1;
  }

  .icp {
    margin-top: 0.25rem !important;
    font-size: 0.75rem !important;
    opacity: 0.5 !important;
  }

  /* ── 宽屏优化 ── 品牌区加宽，导航间距自适应 */
  @media (min-width: 1400px) {
    .footer-brand {
      max-width: 360px;
    }

    .footer-nav {
      gap: 4rem;
    }
  }

  /* ── 响应式 ── */
  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 2rem;
    }

    .footer-brand {
      max-width: none;
    }

    .footer-nav {
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .footer-nav {
      gap: 1.5rem;
    }

    .nav-group {
      min-width: 80px;
    }

    .footer-body {
      padding: 2rem 0 1.5rem;
    }
  }
</style>
