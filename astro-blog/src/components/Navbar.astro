---
// Navbar.astro - 导航栏组件
// Requirements: 4.1, 4.2, 4.3, 4.4
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<nav class:list={["navbar", { "navbar--transparent": transparent }]}>
  <div class="container navbar-inner">
    <div class="navbar-left">
      <a href="/" class="site-logo" aria-label="首页">
        <span class="logo-text">Rebellion</span>
      </a>
      <button class="menu-btn" aria-label="菜单">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>菜单</span>
      </button>
    </div>
    <div class="navbar-right">
      <ThemeToggle />
      <a href="/rss.xml" class="nav-action" aria-label="RSS 订阅" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
      </a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  /* 透明模式 - 用于 hero 页面 */
  .navbar--transparent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background: transparent;
    border-bottom: none;
    backdrop-filter: none;
  }

  .navbar--transparent .site-logo,
  .navbar--transparent .menu-btn,
  .navbar--transparent .nav-action,
  .navbar--transparent :global(.theme-toggle) {
    color: rgba(255, 255, 255, 0.9);
  }

  .navbar--transparent .menu-btn:hover,
  .navbar--transparent .nav-action:hover,
  .navbar--transparent :global(.theme-toggle:hover) {
    background-color: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .navbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-text {
    display: inline-flex;
    align-items: center;
    gap: 0;
    font-family: "Caveat", cursive;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
  }

  .logo-word {
    position: relative;
  }

  .logo-deco {
    display: inline-flex;
    align-items: center;
    margin: 0 -1px;
    position: relative;
    top: -2px;
    color: var(--color-accent);
    transition: transform 0.3s ease, color 0.2s ease;
  }

  .site-logo:hover .logo-deco {
    transform: rotate(15deg) scale(1.15);
  }

  .navbar--transparent .logo-text {
    color: rgba(255, 255, 255, 0.95);
  }

  .navbar--transparent .logo-deco {
    color: #f4845f;
  }

  .site-logo:hover {
    text-decoration: none;
    opacity: 1;
  }

  .site-logo:hover .logo-text {
    color: var(--color-accent);
  }

  .navbar--transparent .site-logo:hover .logo-text {
    color: #fff;
  }

  .menu-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .menu-btn:hover {
    background-color: var(--color-border);
  }

  .menu-btn svg {
    display: block;
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--color-text);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav-action:hover {
    background-color: var(--color-border);
    color: var(--color-accent);
    text-decoration: none;
    opacity: 1;
  }
</style>
