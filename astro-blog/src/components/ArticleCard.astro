---
// ArticleCard.astro - 文章卡片组件
// Requirements: 2.2, 2.4, 6.2, 6.3
interface Props {
  title: string;
  date: Date;
  slug: string;
  excerpt: string;
  /** 自定义 URL，默认为 /posts/{slug} */
  url?: string;
  category?: string;
  tags?: string[];
}

const { title, date, slug, excerpt, url, category, tags } = Astro.props;

const formattedDate = date.toISOString().slice(0, 10);
const postUrl = url ?? `/posts/${slug}`;
---

<article class="card article-card">
  <a href={postUrl} class="card-link">
    <h2 class="card-title">{title}</h2>
    <div class="card-meta">
      <time class="card-date" datetime={formattedDate}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {formattedDate}
      </time>
      {category && category !== '未分类' && (
        <span class="card-category">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                  {category.split('/').join(' / ')}
                </span>
      )}
    </div>
    <p class="card-excerpt">{excerpt}</p>
    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="card-tag">#{tag}</span>
        ))}
      </div>
    )}
    <span class="read-more">阅读更多 →</span>
  </a>
</article>

<style>
  .article-card {
    position: relative;
    padding: 0;
    overflow: hidden;
  }

  .card-link {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: none;
    opacity: 1;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    transition: color 0.2s ease;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .article-card:hover .card-title {
    color: var(--color-accent);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .card-date {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .card-category {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.8rem;
    color: var(--color-accent);
    opacity: 0.85;
  }

  .card-excerpt {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .card-tag {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    background-color: var(--color-code-bg);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .read-more {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .article-card:hover .read-more {
    transform: translateX(4px);
  }
</style>
