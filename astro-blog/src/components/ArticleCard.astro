---
// ArticleCard.astro - 文章卡片组件
// Requirements: 2.2, 2.4, 6.2, 6.3
interface Props {
  title: string;
  date: Date;
  slug: string;
  excerpt: string;
}

const { title, date, slug, excerpt } = Astro.props;

const formattedDate = date.toISOString().slice(0, 10);
const postUrl = `/posts/${slug}`;
---

<article class="card article-card">
  <a href={postUrl} class="card-link">
    <h2 class="card-title">{title}</h2>
    <time class="card-date" datetime={formattedDate}>{formattedDate}</time>
    <p class="card-excerpt">{excerpt}</p>
    <span class="read-more">阅读更多 →</span>
  </a>
</article>

<style>
  .article-card {
    position: relative;
    padding: 0;
    overflow: hidden;
  }

  .card-link {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: none;
    opacity: 1;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .article-card:hover .card-title {
    color: var(--color-accent);
  }

  .card-date {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .card-excerpt {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .read-more {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .article-card:hover .read-more {
    transform: translateX(4px);
  }
</style>
