---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublished } from '../../utils/posts';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return filterPublished(allNotes).map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formattedDate = note.data.date.toISOString().slice(0, 10);
const category = note.data.category ?? '未分类';
const tags = note.data.tags ?? [];
---

<BaseLayout title={note.data.title} description={`${note.data.title} - ${category}`}>
  <article class="prose">
    <header class="post-header">
      <div class="post-meta-row">
        <a href={`/categories/${category}`} class="meta-category">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          {category}
        </a>
        <span class="meta-separator">·</span>
        <time datetime={formattedDate}>{formattedDate}</time>
        {tags.length > 0 && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-tags">
              {tags.map((tag) => (
                <a href={`/tags/${tag}`} class="meta-tag">#{tag}</a>
              ))}
            </span>
          </>
        )}
        <span class="meta-separator">·</span>
        <span class="post-type-badge">笔记</span>
      </div>
    </header>

    <div class="prose-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/notes" class="back-link">← 返回笔记列表</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .meta-category {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .meta-category:hover {
    text-decoration: underline;
  }

  .meta-separator {
    color: var(--color-border);
    font-weight: 300;
  }

  .meta-tags {
    display: inline-flex;
    gap: 0.4rem;
  }

  .meta-tag {
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    opacity: 0.85;
  }

  .meta-tag:hover {
    opacity: 1;
  }

  .post-type-badge {
    font-size: 0.75rem;
    padding: 0.1rem 0.45rem;
    background-color: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .post-meta-row time {
    color: var(--color-text-secondary);
  }

  /* prose 排版样式已提取至 global.css .prose-content */

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    opacity: 1;
  }
</style>
