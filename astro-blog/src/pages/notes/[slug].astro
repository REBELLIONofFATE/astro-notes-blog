---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { filterPublished } from '../../utils/posts';
import { extractHeadings } from '../../utils/headings';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return filterPublished(allNotes).map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formattedDate = note.data.date.toISOString().slice(0, 10);
const category = note.data.category ?? '未分类';
const tags = note.data.tags ?? [];
const headings = extractHeadings(note.body ?? '');
---

<BaseLayout title={note.data.title} description={`${note.data.title} - ${category}`}>
  <div class="article-layout">
    <article class="prose">
      <header class="post-header">
        <div class="post-meta-row">
        <a href={`/categories/${category}`} class="meta-category">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          {category}
        </a>
        <span class="meta-separator">·</span>
        <time datetime={formattedDate}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {formattedDate}
        </time>
        {tags.length > 0 && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-tags">
              {tags.map((tag) => (
                <a href={`/tags/${tag}`} class="meta-tag">#{tag}</a>
              ))}
            </span>
          </>
        )}
        <span class="meta-separator">·</span>
        <span class="post-type-badge">笔记</span>
      </div>
    </header>

    <div class="prose-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/notes" class="back-link">← 返回笔记列表</a>
    </footer>
  </article>

    <aside class="article-sidebar">
      <div class="toc-sticky">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .article-layout {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    transform: translateX(-7rem);
  }

  .prose {
    min-width: 0;
  }

  .article-sidebar {
    position: absolute;
    left: calc(100% + 3rem);
    top: 0;
    bottom: 0;
    width: 200px;
    pointer-events: none;
  }

  .article-sidebar > * {
    pointer-events: auto;
  }

  .toc-sticky {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  @media (max-width: 1200px) {
    .article-layout {
      max-width: 100%;
    }

    .article-sidebar {
      position: static;
      width: 100%;
      pointer-events: auto;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    .toc-sticky {
      position: static;
      max-height: none;
    }
  }

  .post-header {
    margin-bottom: 0.5rem;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .meta-category {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .meta-category:hover {
    text-decoration: underline;
  }

  .meta-separator {
    color: var(--color-border);
    font-weight: 300;
  }

  .meta-tags {
    display: inline-flex;
    gap: 0.4rem;
  }

  .meta-tag {
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    opacity: 0.85;
  }

  .meta-tag:hover {
    opacity: 1;
  }

  .post-type-badge {
    font-size: 0.75rem;
    padding: 0.1rem 0.45rem;
    background-color: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .post-meta-row time {
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  /* prose 排版样式已提取至 global.css .prose-content */

  .post-footer {
    margin-top: 3rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    opacity: 1;
  }
</style>
