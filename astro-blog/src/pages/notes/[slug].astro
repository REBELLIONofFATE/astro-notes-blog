---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublished } from '../../utils/posts';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  return filterPublished(allNotes).map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formattedDate = note.data.date.toISOString().slice(0, 10);
const category = note.data.category ?? '未分类';
const tags = note.data.tags ?? [];
---

<BaseLayout title={note.data.title} description={`${note.data.title} - ${category}`}>
  <article class="prose">
    <header class="post-header">
      <div class="post-meta-top">
        <a href={`/categories/${category}`} class="post-category">📁 {category}</a>
        <span class="post-type-badge">笔记</span>
      </div>
      <h1>{note.data.title}</h1>
      <div class="post-meta">
        <time datetime={formattedDate}>{formattedDate}</time>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/notes" class="back-link">← 返回笔记列表</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-category {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .post-category:hover {
    text-decoration: underline;
    opacity: 1;
  }

  .post-type-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    background-color: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-secondary);
  }

  .post-header h1 {
    font-size: 2rem;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    opacity: 0.85;
  }

  .tag:hover {
    opacity: 1;
    text-decoration: none;
  }

  /* prose 排版样式已提取至 global.css .prose-content */

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    opacity: 1;
  }
</style>
