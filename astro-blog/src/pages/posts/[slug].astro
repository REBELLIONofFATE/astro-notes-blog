---
// [slug].astro - 文章详情页
// Requirements: 1.4, 1.5, 3.1, 3.2, 3.3, 3.4, 3.5
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { filterPublished } from "../../utils/posts";
import { extractHeadings } from "../../utils/headings";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  return filterPublished(allPosts).map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toISOString().slice(0, 10);
const headings = extractHeadings(post.body ?? '');
---

<BaseLayout title={post.data.title} description={`${post.data.title} - 发布于 ${formattedDate}`}>
  <div class="article-layout">
    <article class="prose">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <time datetime={formattedDate}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {formattedDate}
        </time>
      </header>
      <div class="prose-content">
        <Content />
      </div>
    </article>

    <aside class="article-sidebar">
      <div class="toc-sticky">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .article-layout {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  .prose {
    min-width: 0;
  }

  .article-sidebar {
    position: absolute;
    left: calc(100% + 3rem);
    top: 0;
    bottom: 0;
    width: 200px;
    pointer-events: none;
  }

  .article-sidebar > * {
    pointer-events: auto;
  }

  .toc-sticky {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  @media (max-width: 1200px) {
    .article-layout {
      max-width: 100%;
    }

    .article-sidebar {
      position: static;
      width: 100%;
      pointer-events: auto;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    .toc-sticky {
      position: static;
      max-height: none;
    }
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    font-size: 2.25rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .post-header time {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  /* prose 排版样式已提取至 global.css .prose-content */
</style>
