---
// [slug].astro - 文章详情页
// Requirements: 1.4, 1.5, 3.1, 3.2, 3.3, 3.4, 3.5
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterPublished } from "../../utils/posts";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  return filterPublished(allPosts).map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toISOString().slice(0, 10);
---

<BaseLayout title={post.data.title} description={`${post.data.title} - 发布于 ${formattedDate}`}>
  <article class="prose">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <time datetime={formattedDate}>{formattedDate}</time>
    </header>
    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: 720px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header h1 {
    font-size: 2.25rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .post-header time {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  /* === Prose 排版样式 === */
  .post-content {
    line-height: 1.8;
    font-size: 1.05rem;
  }

  /* 标题 */
  .post-content :global(h1) {
    font-size: 2rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-size: 1.1rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  /* 段落 */
  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  /* 列表 */
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(li) {
    margin-bottom: 0.35rem;
    line-height: 1.7;
  }

  .post-content :global(li > ul),
  .post-content :global(li > ol) {
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  /* 引用 */
  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background-color: var(--color-code-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post-content :global(blockquote p) {
    margin-bottom: 0;
  }

  /* 代码 */
  .post-content :global(code) {
    font-family: "Fira Code", "JetBrains Mono", "SF Mono", Consolas, monospace;
    font-size: 0.9em;
    background-color: var(--color-code-bg);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .post-content :global(pre) {
    background-color: var(--color-code-bg);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-border);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* 表格 */
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .post-content :global(th) {
    background-color: var(--color-code-bg);
    font-weight: 600;
  }

  /* 图片 */
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }

  /* 链接 */
  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    opacity: 0.85;
  }

  /* 分割线 */
  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  /* 强调 */
  .post-content :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  .post-content :global(em) {
    font-style: italic;
  }
</style>
