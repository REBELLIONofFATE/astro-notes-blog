---
// page/[page].astro - 分页页（第 2 页起）
import { getCollection } from "astro:content";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { filterPublished, sortByDateDesc, extractExcerpt, getNoteUrl, getPostUrl } from "../../utils/posts";
import "../../styles/global.css";

export async function getStaticPaths() {
  const PAGE_SIZE = 10;

  const [allPosts, allNotes] = await Promise.all([
    getCollection("posts"),
    getCollection("notes"),
  ]);

  const allContent = sortByDateDesc(
    filterPublished([...allPosts, ...allNotes])
  );

  const totalPages = Math.ceil(allContent.length / PAGE_SIZE);

  // 从第 2 页开始生成（第 1 页是 index.astro）
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const pageNum = i + 2;
    return {
      params: { page: String(pageNum) },
      props: {
        items: allContent.slice((pageNum - 1) * PAGE_SIZE, pageNum * PAGE_SIZE),
        currentPage: pageNum,
        totalPages,
        total: allContent.length,
      },
    };
  });
}

const { items, currentPage, totalPages, total } = Astro.props;

function getItemUrl(item: { data: { slug: string; type?: string } }): string {
  return item.data.type === 'note' ? getNoteUrl(item.data.slug) : getPostUrl(item.data.slug);
}

// 分页链接范围（前后各 2 页）
const rangeStart = Math.max(2, currentPage - 2);
const rangeEnd = Math.min(totalPages, currentPage + 2);
const pageNumbers: number[] = [];
for (let i = rangeStart; i <= rangeEnd; i++) {
  pageNumbers.push(i);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>第 {currentPage} 页 - 我的博客</title>
    <meta name="description" content="一个使用 Astro 构建的个人博客，分享编程、技术与生活的思考" />
    <meta property="og:title" content="第 {currentPage} 页 - 我的博客" />
    <meta property="og:description" content="一个使用 Astro 构建的个人博客" />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="我的博客 RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@700;900&family=LXGW+WenKai:wght@400&family=Caveat:wght@700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "dark" && theme !== "light") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <Navbar />

    <main class="container main-content">
      <div class="page-header">
        <h1 class="page-title">全部内容</h1>
        <p class="page-desc">第 {currentPage} / {totalPages} 页 · 共 {total} 篇</p>
      </div>

      <section class="posts-list">
        {items.map((item) => (
          <ArticleCard
            title={item.data.title}
            date={item.data.date}
            slug={item.data.slug}
            excerpt={extractExcerpt(item.body ?? "")}
            url={getItemUrl(item)}
            category={item.data.category}
            tags={item.data.tags}
          />
        ))}
      </section>

      <!-- 分页导航 -->
      <nav class="pagination">
        <div class="page-links">
          {currentPage > 2 && <a href="/page/{currentPage - 1}" class="page-btn">← 上一页</a>}
          {currentPage === 2 && <a href="/" class="page-btn">← 上一页</a>}

          {rangeStart > 2 && (
            <>
              <a href="/" class="page-num">1</a>
              <span class="page-ellipsis">…</span>
            </>
          )}

          {pageNumbers.map((num) => (
            num === currentPage
              ? <span class="page-num page-num--active">{num}</span>
              : num === 2
                ? <a href="/" class="page-num">{num}</a>
                : <a href="/page/{num}" class="page-num">{num}</a>
          ))}

          {rangeEnd < totalPages && (
            <>
              <span class="page-ellipsis">…</span>
              <a href="/page/{totalPages}" class="page-num">{totalPages}</a>
            </>
          )}

          {currentPage < totalPages && <a href="/page/{currentPage + 1}" class="page-btn">下一页 →</a>}
        </div>
      </nav>
    </main>

    <Footer />
  </body>
</html>

<style>
  .main-content {
    min-height: calc(100vh - 64px - 120px);
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    margin-bottom: 0.3rem;
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pagination {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .page-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .page-btn, .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .page-btn:hover, .page-num:hover {
    background-color: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .page-num--active {
    background-color: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    cursor: default;
  }

  .page-ellipsis {
    padding: 0 0.25rem;
    color: var(--color-text-secondary);
  }
</style>
