---
// index.astro - 首页（全部内容列表，第 1 页）
// Requirements: 1.3, 2.1, 2.2, 2.3, 2.5
import { getCollection } from "astro:content";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { filterPublished, sortByDateDesc, extractExcerpt, getNoteUrl, getPostUrl } from "../utils/posts";
import "../styles/global.css";

const PAGE_SIZE = 10;

const [allPosts, allNotes] = await Promise.all([
  getCollection("posts"),
  getCollection("notes"),
]);

// 合并所有内容（posts + notes），过滤草稿，按日期降序
const allContent = sortByDateDesc(
  filterPublished([
    ...allPosts,
    ...allNotes,
  ])
);

const totalPages = Math.ceil(allContent.length / PAGE_SIZE);
const currentPage = 1;
const items = allContent.slice(0, PAGE_SIZE);

function getItemUrl(item: { data: { slug: string; type?: string } }): string {
  return item.data.type === 'note' ? getNoteUrl(item.data.slug) : getPostUrl(item.data.slug);
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>我的博客</title>
    <meta name="description" content="一个使用 Astro 构建的个人博客，分享编程、技术与生活的思考" />
    <meta property="og:title" content="我的博客" />
    <meta property="og:description" content="一个使用 Astro 构建的个人博客，分享编程、技术与生活的思考" />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="我的博客 RSS" href="/rss.xml" />
    <!-- Google Fonts: 思源宋体 + 霞鹜文楷 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@700;900&family=LXGW+WenKai:wght@400&family=Caveat:wght@700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "dark" && theme !== "light") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <!-- 全局导航栏 -->
    <Navbar transparent={true} />

    <!-- Hero 区域 -->
    <div class="hero-wrapper">
      <section class="hero">
        <h1 class="hero-title">Rebellion's Blog</h1>
        <p class="hero-desc">一个程序员的自留地，写代码、聊技术、记录生活中那些值得回味的瞬间</p>
        <div class="hero-actions">
          <a href="#posts" class="hero-btn hero-btn--primary">开始阅读</a>
          <a href="/notes" class="hero-btn hero-btn--outline">浏览笔记</a>
        </div>
      </section>
    </div>

    <!-- 占位符，防止内容被固定导航栏遮挡 -->
    <div class="hero-spacer"></div>

    <!-- 内容列表 -->
    <main class="container main-content" id="posts">
      <section class="posts-list">
        {items.map((item) => (
          <ArticleCard
            title={item.data.title}
            date={item.data.date}
            slug={item.data.slug}
            excerpt={extractExcerpt(item.body ?? "")}
            url={getItemUrl(item)}
            category={item.data.category}
            tags={item.data.tags}
          />
        ))}
      </section>

      <!-- 分页信息 -->
      <div class="pagination">
        <span class="page-info">第 {currentPage} / {totalPages} 页 · 共 {allContent.length} 篇</span>
        <div class="page-links">
          {totalPages > 1 && <a href="/page/2" class="page-btn page-next">下一页 →</a>}
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .hero-wrapper {
    position: relative;
    background: url('/wallhaven-95z1q1.jpg') center/cover no-repeat;
    overflow: hidden;
  }

  /* 占位符，高度与导航栏初始高度相同 */
  .hero-spacer {
    height: 72px;
  }

  .hero-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(72, 202, 228, 0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(76, 159, 112, 0.12) 0%, transparent 50%);
    pointer-events: none;
  }

  /* 半透明遮罩层，层级在背景之上、文字之下 */
  .hero-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    pointer-events: none;
    z-index: 0;
  }

  /* 半透明遮罩层，层级在背景之上、文字之下 */
  .hero-wrapper::after {
    z-index: 1;
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    pointer-events: none;
    z-index: 0;
  }

  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 1.5rem 7rem;
    min-height: 80vh;
    color: #fff;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 20px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-family: Lato, "Helvetica Neue", Arial, Helvetica, sans-serif;
    font-size: 3.8rem;
    font-weight: 900;
    color: #fff;
    margin-bottom: 0.75rem;
    letter-spacing: 0.02em;
  }

  .hero-desc {
    font-family: "LXGW WenKai", cursive;
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .hero-btn:hover {
    text-decoration: none;
    opacity: 1;
    transform: translateY(-1px);
  }

  .hero-btn--primary {
    background-color: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .hero-btn--primary:hover {
    background-color: rgba(255, 255, 255, 0.22);
    color: #fff;
  }

  .hero-btn--outline {
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .hero-btn--outline:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .main-content {
    min-height: calc(100vh - 64px - 120px);
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .page-info {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .page-links {
    display: flex;
    gap: 0.5rem;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent);
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .page-btn:hover {
    background-color: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .page-btn--disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1rem 5rem;
      min-height: 60vh;
    }
    .hero-title {
      font-size: 2.25rem;
    }
    .hero-desc {
      font-size: 1.05rem;
    }
  }
</style>
